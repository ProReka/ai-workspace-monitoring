# Local dev: empty = mock mode (UI still renders for evaluation).
# Copy to .env and fill in; .env is gitignored, never commit secrets.
MULTICA_TOKEN=
MULTICA_WORKSPACE=
MULTICA_SERVER_URL=
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
NINEROUTER_PASSWORD=SET-IN-local-dot-env
# Dashboard cookie (optional, only if auto-login is unavailable):
# NINEROUTER_COOKIE=
# Daemon IDs treated as first-class (comma-separated, empty = all known):
# KNOWN_DAEMONS=main,backend,frontend
AWS_REGION=
ECS_CLUSTER=
POLL_MULTICA_S=20
POLL_ROUTER_S=15
POLL_ECS_S=30
REFRESH_S=60
PORT=8080
COMPANY_NAME="Acme Corp"
